# Copy to .env and fill in. Never commit keys.
# Every variable used by contracts, api, web and ops.
# See specs/001-second-wind/quickstart.md §1.

# keys (never commit)
DEPLOYER_KEY=
BORROWER_KEY=
LIQUIDATOR_KEY=

# rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
LASNA_RPC=https://lasna-rpc.rnk.dev/

# fixed addresses
MORPHO=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
# Reactive Network's system contract on Lasna: it emits CallbackRequest for every dispatch.
REACTIVE_SYSTEM_CONTRACT=0x8888888888888888888888888888888888888888
BASE_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
UNICHAIN_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
UNISWAP_V3_FACTORY=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
UNISWAP_V3_NPM=0x27F971cb582BF9E50F397e4d29a5C7A34f11faA2
UNISWAP_SWAP_ROUTER=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4

# chain ids (used by the reactive contract and the deploy scripts)
BASE_SEPOLIA_CHAIN_ID=84532
UNICHAIN_SEPOLIA_CHAIN_ID=1301
# ETH sent to the reactive contract at deploy, in wei
REACTIVE_DEPOSIT_WEI=0

# deployed contracts (written to ops/addresses.json by contracts/script/*.s.sol)
COVERAGE_POOL_ADDRESS=
CLAIM_VAULT_ADDRESS=
REACTIVE_ADDRESS=
BASE_REGISTRY_ADDRESS=
BASE_COVER_ASSET=
UNICHAIN_COVER_ASSET=

# indexer
INDEXER_START_BASE=0
INDEXER_START_UNICHAIN=0
INDEXER_START_REACTIVE=0
INDEXER_CONFIRMATIONS=5
INDEXER_POLL_MS=5000

# app
VITE_API_URL=http://localhost:8080
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# direct Postgres connection string, used only by the migration runner
DATABASE_URL=
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
VERSION=0.1.0

# web build (Vite only exposes VITE_*)
VITE_WALLETCONNECT_PROJECT_ID=
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
VITE_LASNA_RPC=https://lasna-rpc.rnk.dev/
VITE_BASE_REGISTRY=
VITE_BASE_COVERAGE_POOL=
VITE_BASE_USDC=
VITE_UNICHAIN_CLAIM_VAULT=
VITE_UNICHAIN_USDC=
VITE_REACTIVE_CONTRACT=
