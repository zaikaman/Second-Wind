{
  "name": "second-wind-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Second Wind read-only indexer and receipt API",
  "engines": {
    "node": "20.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "indexer:once": "tsx src/services/indexer.ts --once",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
